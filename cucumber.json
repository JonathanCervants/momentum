{
  "default": {
    "paths": [
      "features/**/*.feature"
    ],
    "require": [
      "support/**/*.ts",
      "steps/**/*.ts"
    ],
    "requireModule": [
      "tsx"
    ],
    "format": [
      "progress-bar",
      "html:cucumber-report.html"
    ],
    "formatOptions": {
      "snippetInterface": "async-await"
    }
  }
}
